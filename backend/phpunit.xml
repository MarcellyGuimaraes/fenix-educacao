<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- O Laravel lê $_SERVER antes de $_ENV, e o <env> não sobrescreve $_SERVER.
             Sem isto, o APP_ENV=production do container venceria e o `migrate`
             do RefreshDatabase pediria confirmação (e não rodaria). -->
        <server name="APP_ENV" value="testing" force="true"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <!-- O container padrão roda com `php artisan optimize`. Apontar os caches
             para arquivos que nunca são gerados faz a suíte sempre carregar a
             config fresca, com os <env> abaixo. -->
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/config.testing.php" force="true"/>
        <env name="APP_ROUTES_CACHE" value="bootstrap/cache/routes.testing.php" force="true"/>
        <env name="APP_EVENTS_CACHE" value="bootstrap/cache/events.testing.php" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <!-- force="true" garante isolamento mesmo quando o container define
             DB_CONNECTION=pgsql / CACHE_STORE=redis no ambiente. -->
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="REDIS_HOST" value="127.0.0.1" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
