# Root env for docker-compose
APP_PORT=8080
FRONTEND_PORT=5173

DB_DATABASE=fenix
DB_USERNAME=fenix
DB_PASSWORD=secret

# Host-side ports (change if they clash with services already running locally).
# Container-internal ports are fixed (Postgres 5432 / Redis 6379).
DB_FORWARD_PORT=5434
REDIS_FORWARD_PORT=6379

VITE_API_URL=http://localhost:8080/api
